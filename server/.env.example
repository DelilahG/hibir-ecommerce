# Copy to server/.env and fill in. Never commit the real file.
NODE_ENV=development
PORT=4000

# PostgreSQL connection strings
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/hibir
TEST_DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/hibir_test

# Origin of the web client allowed by CORS (Vite dev server by default)
CLIENT_ORIGIN=http://localhost:5173

# Set to true when served over HTTPS so session cookies are marked Secure
COOKIE_SECURE=false
SESSION_TTL_DAYS=14

# Used only by `npm run db:seed` to create the first administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_to_a_long_password
